prefix=${pcfiledir}
libdir=${prefix}
includedir=${prefix}

Name: libmimalloc
Description: A compact general purpose allocator with excellent performance
Version: 3.1
URL: https://github.com/microsoft/mimalloc/
Libs: -L${libdir} -lmimalloc
Libs.private:  -lpthread -lrt -latomic
Cflags: -I${includedir}
